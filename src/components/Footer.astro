---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();

const links = [
  { href: site.instagram, label: "Instagram", external: true },
  { href: `mailto:${site.contactEmail}`, label: "Contato", external: false },
  { href: "/privacidade", label: "Privacidade", external: false },
  { href: "/termos", label: "Termos", external: false },
];
---

<footer class="sr-section sr-dark sr-footer">
  <div class="sr-container sr-footer-inner">
    <div class="sr-footer-brand">
      <Logo size={24} />
      <p class="sr-footer-tag">Feito por quem ama surf.</p>
    </div>

    <nav class="sr-footer-nav" aria-label="Links do rodapé">
      {
        links.map((l) => (
          <a
            href={l.href}
            rel={l.external ? "noopener noreferrer" : undefined}
            target={l.external ? "_blank" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="sr-container sr-footer-base">
    <div class="sr-hairline"></div>
    <div class="sr-footer-legal">
      <span>© {year} SurfRise</span>
      <span>A análise não substitui a avaliação de um profissional.</span>
    </div>
  </div>
</footer>

<style>
  .sr-footer {
    background: var(--color-abyss);
    padding-block: clamp(3.5rem, 8vw, 5rem) clamp(2rem, 4vw, 2.75rem);
  }
  .sr-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 3rem);
  }
  .sr-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: #fff;
  }
  .sr-footer-tag {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }
  .sr-footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }
  .sr-footer-nav a {
    position: relative;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.35s ease;
  }
  .sr-footer-nav a:hover {
    color: #fff;
  }
  .sr-footer-base {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }
  .sr-footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    margin-top: 1.5rem;
    font-size: 0.78125rem;
    /* Não é o --fg-faint: sobre o abismo ele dá 4,23 de contraste e o mínimo
       AA para este tamanho é 4,5. Este tom dá 5,6 e continua discreto. */
    color: #7f8899;
  }
</style>

---
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/inter";
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SurfRise — Descubra o que está limitando seu surf",
  description =
    "Envie fotos ou vídeo da sua sessão e receba uma análise completa do seu surf: notas por aspecto, pontos fortes, pontos fracos e um treino criado para você.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://surfrise.com.br");
const metaPixelEnabled = site.metaPixelId !== "YOUR_PIXEL_ID";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#04070f" />

    <!-- O pôster da hero é background-image (ver Hero.astro). O preload devolve
         a descoberta antecipada que o preload scanner dava na <img>. -->
    <link rel="preload" as="image" href="/hero-tall.webp" media="(max-width: 999px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/hero-wide.webp" media="(min-width: 1000px)" fetchpriority="high" />

    <!-- Google tag (gtag.js) — o gtag.js sozinho é 170 kB, mais que todo o
         resto da página junta. Baixá-lo no <head> fazia ele disputar banda com
         a hero. A fila do dataLayer é montada aqui e o script vem depois do
         load: comandos e cliques anteriores ficam na fila e são reproduzidos
         quando a lib chega, então nada de medição se perde.

         O aviso de cookies no fim do body é apenas informativo (sem opt-out) —
         a medição roda sempre, independente do aviso ter sido fechado. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.srInitGa = function () {
        if (window.__srGaInit) return;
        window.__srGaInit = true;
        gtag("js", new Date());
        gtag("config", "G-3VGRQB78MF");
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=G-3VGRQB78MF";
        document.head.appendChild(s);
      };
      if (document.readyState === "complete") window.srInitGa();
      else window.addEventListener("load", window.srInitGa, { once: true });
    </script>

    {
      metaPixelEnabled && (
        <Fragment>
          {/* Meta Pixel — mesmo tratamento de "carrega depois do load" do gtag
             acima: fbevents.js soma outro tanto de KB disputando banda com a
             hero. PageView é disparado assim que o script chega; para uma LP
             estática (sem client-side routing) isso já cobre uma visita por
             carregamento de página, sem precisar refirar em SPA. */}
          <script is:inline define:vars={{ pixelId: site.metaPixelId }}>
            window.srInitPixel = function () {
              if (window.__srPixelInit) return;
              window.__srPixelInit = true;
              !(function (f, b, e, v, n, t, s) {
                if (f.fbq) return;
                n = f.fbq = function () {
                  n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
                };
                if (!f._fbq) f._fbq = n;
                n.push = n;
                n.loaded = true;
                n.version = "2.0";
                n.queue = [];
                t = b.createElement(e);
                t.async = true;
                t.src = v;
                s = b.getElementsByTagName(e)[0];
                s.parentNode.insertBefore(t, s);
              })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
              fbq("init", pixelId);
              fbq("track", "PageView");
            };
            if (document.readyState === "complete") window.srInitPixel();
            else window.addEventListener("load", window.srInitPixel, { once: true });
          </script>
          <noscript>
            <img
              height="1"
              width="1"
              style="display:none"
              src={`https://www.facebook.com/tr?id=${site.metaPixelId}&ev=PageView&noscript=1`}
            />
          </noscript>
        </Fragment>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SurfRise" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site ?? "https://surfrise.com.br")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SurfRise — Surfe. Analise. Evolua." />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Set the motion flag before paint so reveals never flash.
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("no-motion");
      }
    </script>
  </head>

  <body class="bg-abyss">
    <a href="#conteudo" class="sr-btn sr-btn-ghost sr-skip">Pular para o conteúdo</a>
    <div id="sr-progress" class="sr-progress" aria-hidden="true"></div>

    <slot />

    <div
      id="sr-consent"
      class="sr-consent"
      role="status"
      aria-label="Aviso de cookies"
      aria-live="polite"
      hidden
    >
      <p class="sr-consent-text">
        Usamos cookies para entender como a página é usada e melhorá-la. Saiba mais na
        <a href="/privacidade">Política de Privacidade</a>.
      </p>
      <div class="sr-consent-actions">
        <button type="button" class="sr-btn sr-btn-primary sr-consent-btn" data-consent-ok>OK</button>
      </div>
    </div>

    <script>
      import Lenis from "lenis";

      const reduced = document.documentElement.classList.contains("no-motion");

      /* ---------- Cookie notice (informativo, sem opt-out) ---------- */
      const consentEl = document.getElementById("sr-consent");
      if (consentEl) {
        let seen: string | null = null;
        try {
          seen = localStorage.getItem("sr-consent-seen");
        } catch {}
        if (!seen) {
          consentEl.hidden = false;
          // rAF so the entrance transition runs after `hidden` is cleared.
          requestAnimationFrame(() => consentEl.classList.add("is-in"));
        }
        consentEl.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement)?.closest<HTMLElement>("[data-consent-ok]");
          if (!btn) return;
          try {
            localStorage.setItem("sr-consent-seen", "1");
          } catch {}
          consentEl.classList.remove("is-in");
          consentEl.hidden = true;
        });
      }

      /* ---------- Smooth, weighted scroll (the "swell") ---------- */
      if (!reduced && window.matchMedia("(min-width: 768px)").matches) {
        const lenis = new Lenis({
          duration: 1.15,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          wheelMultiplier: 1,
          touchMultiplier: 1.6,
        });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
          a.addEventListener("click", (e) => {
            const id = a.getAttribute("href");
            if (!id || id === "#") return;
            const target = document.querySelector(id);
            if (!target) return;
            e.preventDefault();
            lenis.scrollTo(target as HTMLElement, { offset: -80 });
          });
        });
      }

      /* ---------- Reveal choreography ---------- */
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduced) {
        items.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      }

      /* ---------- GA event tracking (CTAs + anchor nav links) ---------- */
      document.addEventListener("click", (e) => {
        const el = (e.target as HTMLElement)?.closest<HTMLElement>("[data-gtag]");
        if (!el) return;
        const [eventName, location] = (el.dataset.gtag ?? "").split(":");
        if (!eventName) return;
        const clone = el.cloneNode(true) as HTMLElement;
        clone.querySelectorAll("[aria-hidden]").forEach((n) => n.remove());
        // @ts-expect-error gtag is loaded globally via the inline GA snippet
        window.gtag?.("event", eventName, {
          link_location: location,
          link_label: clone.textContent?.trim().replace(/\s+/g, " "),
          link_url: el instanceof HTMLAnchorElement ? el.href : undefined,
        });
      });

      /* ---------- Nav state + scroll progress ---------- */
      const nav = document.getElementById("sr-nav");
      const progress = document.getElementById("sr-progress");

      let ticking = false;
      const update = () => {
        ticking = false;
        const y = window.scrollY;
        // Nav enxuta (páginas legais) já nasce sólida e não deve destravar.
        if (nav && !nav.hasAttribute("data-solid")) nav.classList.toggle("is-stuck", y > 24);
        if (progress) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
        }
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      update();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
    </script>
  </body>
</html>
